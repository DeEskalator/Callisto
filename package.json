{
  "name": "callisto",
  "version": "0.1.0",
  "private": true,
  "description": "KI-Telefonassistent für Arztpraxen auf AWS",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "infra"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "synth": "npm run build && npm run synth --workspace infra",
    "diff": "npm run build && npm run diff --workspace infra",
    "deploy": "npm run build && npm run deploy --workspace infra",
    "dev:api": "npm run dev --workspace @callisto/api",
    "dev:web": "npm run dev --workspace @callisto/web",
    "build": "npm run build --workspace @callisto/web"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@types/node": "^24.10.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
